{
  "name": "controle-financeiro",
  "productName": "Controle Financeiro",
  "version": "1.1.2",
  "description": "Controle financeiro por estabelecimento (entradas e saídas)",
  "main": "src/main.js",
  "author": "Aleijado",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "electron .",
    "test": "node --test test/*.test.js",
    "dist": "electron-builder --win nsis --publish never",
    "release": "electron-builder --win nsis --publish always"
  },
  "build": {
    "appId": "br.com.controlefinanceiro.app",
    "productName": "Controle Financeiro",
    "files": [
      "src/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "language": "1046",
      "artifactName": "Controle-Financeiro-Setup-${version}.${ext}"
    },
    "extraResources": [
      {
        "from": "node_modules/archiver-utils",
        "to": "node_modules/archiver-utils"
      },
      {
        "from": "node_modules/call-bind-apply-helpers",
        "to": "node_modules/call-bind-apply-helpers"
      },
      {
        "from": "node_modules/call-bound",
        "to": "node_modules/call-bound"
      },
      {
        "from": "node_modules/concat-map",
        "to": "node_modules/concat-map"
      },
      {
        "from": "node_modules/core-util-is",
        "to": "node_modules/core-util-is"
      },
      {
        "from": "node_modules/dunder-proto",
        "to": "node_modules/dunder-proto"
      },
      {
        "from": "node_modules/es-abstract-get",
        "to": "node_modules/es-abstract-get"
      },
      {
        "from": "node_modules/es-define-property",
        "to": "node_modules/es-define-property"
      },
      {
        "from": "node_modules/es-errors",
        "to": "node_modules/es-errors"
      },
      {
        "from": "node_modules/es-object-atoms",
        "to": "node_modules/es-object-atoms"
      },
      {
        "from": "node_modules/fs.realpath",
        "to": "node_modules/fs.realpath"
      },
      {
        "from": "node_modules/function-bind",
        "to": "node_modules/function-bind"
      },
      {
        "from": "node_modules/get-intrinsic",
        "to": "node_modules/get-intrinsic"
      },
      {
        "from": "node_modules/get-proto",
        "to": "node_modules/get-proto"
      },
      {
        "from": "node_modules/glob",
        "to": "node_modules/glob"
      },
      {
        "from": "node_modules/gopd",
        "to": "node_modules/gopd"
      },
      {
        "from": "node_modules/graceful-fs",
        "to": "node_modules/graceful-fs"
      },
      {
        "from": "node_modules/has-symbols",
        "to": "node_modules/has-symbols"
      },
      {
        "from": "node_modules/hasown",
        "to": "node_modules/hasown"
      },
      {
        "from": "node_modules/inflight",
        "to": "node_modules/inflight"
      },
      {
        "from": "node_modules/inherits",
        "to": "node_modules/inherits"
      },
      {
        "from": "node_modules/is-callable",
        "to": "node_modules/is-callable"
      },
      {
        "from": "node_modules/lazystream",
        "to": "node_modules/lazystream"
      },
      {
        "from": "node_modules/lodash.defaults",
        "to": "node_modules/lodash.defaults"
      },
      {
        "from": "node_modules/lodash.difference",
        "to": "node_modules/lodash.difference"
      },
      {
        "from": "node_modules/lodash.flatten",
        "to": "node_modules/lodash.flatten"
      },
      {
        "from": "node_modules/lodash.isplainobject",
        "to": "node_modules/lodash.isplainobject"
      },
      {
        "from": "node_modules/lodash.union",
        "to": "node_modules/lodash.union"
      },
      {
        "from": "node_modules/math-intrinsics",
        "to": "node_modules/math-intrinsics"
      },
      {
        "from": "node_modules/normalize-path",
        "to": "node_modules/normalize-path"
      },
      {
        "from": "node_modules/object-inspect",
        "to": "node_modules/object-inspect"
      },
      {
        "from": "node_modules/once",
        "to": "node_modules/once"
      },
      {
        "from": "node_modules/path-is-absolute",
        "to": "node_modules/path-is-absolute"
      },
      {
        "from": "node_modules/process-nextick-args",
        "to": "node_modules/process-nextick-args"
      },
      {
        "from": "node_modules/side-channel-list",
        "to": "node_modules/side-channel-list"
      },
      {
        "from": "node_modules/side-channel-map",
        "to": "node_modules/side-channel-map"
      },
      {
        "from": "node_modules/side-channel-weakmap",
        "to": "node_modules/side-channel-weakmap"
      },
      {
        "from": "node_modules/util-deprecate",
        "to": "node_modules/util-deprecate"
      },
      {
        "from": "node_modules/wrappy",
        "to": "node_modules/wrappy"
      }
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "Wfelipetm",
        "repo": "controle-financeiro",
        "releaseType": "release"
      }
    ]
  },
  "dependencies": {
    "call-bind-apply-helpers": "^1.0.2",
    "electron-updater": "^6.8.11",
    "exceljs": "^4.4.0"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/Wfelipetm/controle-financeiro.git"
  }
}
